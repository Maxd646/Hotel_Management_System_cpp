#include <iostream>
#include <iomanip>
#include <string>
#include <mysql/mysql.h> // MySQL C API

using namespace std;

// Constants
const int TOTAL_ROOMS = 100;
const int NUM_ROOM_TYPES = 5;
const string DB_HOST = "localhost";
const string DB_USER = "root";
const string DB_PASS = "password";  // <-- Replace with your MySQL password
const string DB_NAME = "hotel_db";

// Room types
string roomTypes[] = {"Single", "Double", "Family", "Deluxe", "Suite"};
int roomPrices[] = {1500, 2500, 5000, 8000, 10000};
int roomSizes[] = {50, 30, 10, 7, 3};

// Structs
struct User {
    string name;
    string id;
    string phone;
};

struct Room {
    bool available;
    int typeIndex;
    User user;
};

// Globals
Room hotel[TOTAL_ROOMS];
int prefixRoomSizes[NUM_ROOM_TYPES + 1] = {0};
MYSQL* conn;

// Function prototypes
void connectDatabase();
void setupDatabase();
void loadFromDatabase();
void saveToDatabase(int roomNumber);
void deleteFromDatabase(int roomNumber);
void initializeHotel();
int showMenu();
void bookRoom();
int registerInfo(int roomNumber);
void showRoomAvailability();
void showRoomDetails();
void showUsersList();
int searchById();
void leaveRoom();
void closeDatabase();

int main() {
    cout << "\n============================================\n";
    cout << "\033[1;32m" << "         Welcome to Utopia Hotel        " << "\033[0m\n";
    cout << "============================================\n";

    connectDatabase();
    setupDatabase();
    initializeHotel();
    loadFromDatabase();

    while (true) {
        int choice = showMenu();
        switch (choice) {
            case 1: bookRoom(); break;
            case 2: showRoomAvailability(); break;
            case 3: showRoomDetails(); break;
            case 4: showUsersList(); break;
            case 5:
                if (searchById() == -1)
                    cout << "\033[1;31mUser not found!\033[0m\n";
                break;
            case 6: leaveRoom(); break;
            case 7:
                closeDatabase();
                return 0;
            default:
                cout << "\033[1;31mInvalid choice! Please try again.\033[0m\n";
        }
    }
    return 0;
}

// Database connection
void connectDatabase() {
    conn = mysql_init(0);
    conn = mysql_real_connect(conn, DB_HOST.c_str(), DB_USER.c_str(), DB_PASS.c_str(), DB_NAME.c_str(), 3306, NULL, 0);
    if (!conn) {
        cout << "\033[1;31mFailed to connect to database!\033[0m\n";
        exit(1);
    }
}

void setupDatabase() {
    const char* createTable = 
        "CREATE TABLE IF NOT EXISTS reservations ("
        "roomNumber INT PRIMARY KEY,"
        "name VARCHAR(50),"
        "id VARCHAR(20),"
        "phone VARCHAR(20)"
        ")";
    if (mysql_query(conn, createTable)) {
        cout << "Error creating table: " << mysql_error(conn) << endl;
    }
}

void loadFromDatabase() {
    if (mysql_query(conn, "SELECT * FROM reservations")) {
        cout << "Error reading data: " << mysql_error(conn) << endl;
        return;
    }

    MYSQL_RES* res = mysql_store_result(conn);
    MYSQL_ROW row;
    while ((row = mysql_fetch_row(res))) {
        int roomNum = stoi(row[0]);
        hotel[roomNum - 1].available = false;
        hotel[roomNum - 1].user.name = row[1];
        hotel[roomNum - 1].user.id = row[2];
        hotel[roomNum - 1].user.phone = row[3];
    }
    mysql_free_result(res);
}

void saveToDatabase(int roomNumber) {
    Room& room = hotel[roomNumber - 1];
    string query = "REPLACE INTO reservations (roomNumber, name, id, phone) VALUES (" +
                   to_string(roomNumber) + ", '" + room.user.name + "', '" + room.user.id + "', '" + room.user.phone + "')";
    if (mysql_query(conn, query.c_str())) {
        cout << "Error saving data: " << mysql_error(conn) << endl;
    }
}

void deleteFromDatabase(int roomNumber) {
    string query = "DELETE FROM reservations WHERE roomNumber=" + to_string(roomNumber);
    if (mysql_query(conn, query.c_str())) {
        cout << "Error deleting data: " << mysql_error(conn) << endl;
    }
}

void closeDatabase() {
    mysql_close(conn);
}

// Hotel initialization
void initializeHotel() {
    for (int i = 0; i < TOTAL_ROOMS; i++) {
        hotel[i].available = true;
    }
    for (int i = 0; i < NUM_ROOM_TYPES; i++) {
        prefixRoomSizes[i + 1] = prefixRoomSizes[i] + roomSizes[i];
    }
    for (int i = 0; i < TOTAL_ROOMS; i++) {
        int type = 0;
        while (i >= prefixRoomSizes[type + 1]) type++;
        hotel[i].typeIndex = type;
    }
}

// Menu
int showMenu() {
    int choice;
menuChoice:
    cout << "\n********** Hotel Menu **********\n";
    cout << "1. Book a Room\n";
    cout << "2. Check Room Availability\n";
    cout << "3. Display Room Details\n";
    cout << "4. Display Users List\n";
    cout << "5. Search users by ID\n";
    cout << "6. Leave room\n";
    cout << "7. Exit\n";
    cout << "Enter your choice: ";
    cin >> choice;
    if (cin.fail() || choice < 1 || choice > 7) {
        cout << "\033[1;31mInvalid choice, please try again.\033[0m\n";
        cin.clear();
        cin.ignore(INT_MAX, '\n');
        goto menuChoice;
    }
    return choice;
}

int registerInfo(int roomNumber) {
    string name, id, phone;
    cout << "Enter your name: ";
    cin.ignore();
    getline(cin, name);
    cout << "Enter your ID: ";
    getline(cin, id);
    cout << "Enter your phone number: ";
    getline(cin, phone);
    if (name.empty() || id.empty() || phone.empty()) {
        cout << "\033[1;31mInvalid input. Registration failed.\033[0m\n";
        return -1;
    }
    hotel[roomNumber - 1].user = {name, id, phone};
    return 0;
}

// Book a room
void bookRoom() {
    int roomNumber;
roomNumberChoice:
    cout << "\nEnter room number to book (1-" << TOTAL_ROOMS << ") (0 to go back): ";
    cin >> roomNumber;
    if (cin.fail() || roomNumber < 0 || roomNumber > TOTAL_ROOMS) {
        cout << "\033[1;31mInvalid room number! Please try again.\033[0m\n";
        cin.clear();
        cin.ignore(INT_MAX, '\n');
        goto roomNumberChoice;
    }
    if (roomNumber == 0) return;
    if (!hotel[roomNumber - 1].available) {
        cout << "\033[1;31mRoom " << roomNumber << " is already booked.\033[0m\n";
        goto roomNumberChoice;
    }

    if (registerInfo(roomNumber) == -1) {
        cout << "\033[1;31mRoom not reserved due to registration failure.\033[0m\n";
        return;
    }

    hotel[roomNumber - 1].available = false;
    saveToDatabase(roomNumber);

    cout << "\033[1;32mRoom " << roomNumber << " of type *" << roomTypes[hotel[roomNumber-1].typeIndex]
         << "* has been successfully booked!\033[0m\n";
}

// Show availability
void showRoomAvailability() {
    cout << "\nRoom Availability:\n";
    for (int i = 0; i < TOTAL_ROOMS; i++) {
        if (hotel[i].available) {
            cout << "Room " << (i + 1) << " (" << roomTypes[hotel[i].typeIndex] << ") is available\n";
        }
    }
}

// Show details
void showRoomDetails() {
    cout << "\nRoom Details:\n";
    for (int i = 0; i < TOTAL_ROOMS; i++) {
        cout << "Room " << (i + 1) << " - " << roomTypes[hotel[i].typeIndex]
             << " - Price: " << roomPrices[hotel[i].typeIndex]
             << " - " << (hotel[i].available ? "Available" : "Booked") << "\n";
    }
}

// Users list
void showUsersList() {
    cout << "\nUsers List:\n";
    for (int i = 0; i < TOTAL_ROOMS; i++) {
        if (!hotel[i].available) {
            cout << "Room " << (i + 1) << ": " << hotel[i].user.name
                 << ", ID: " << hotel[i].user.id
                 << ", Phone: " << hotel[i].user.phone << endl;
        }
    }
}

// Search by ID
int searchById() {
    string searchId;
    cout << "Enter ID to search: ";
    cin.ignore();
    getline(cin, searchId);
    for (int i = 0; i < TOTAL_ROOMS; i++) {
        if (!hotel[i].available && hotel[i].user.id == searchId) {
            cout << "User found: " << hotel[i].user.name << " in Room " << (i + 1) << endl;
            return i;
        }
    }
    return -1;
}

// Leave room
void leaveRoom() {
    int roomNumber;
    cout << "Enter room number to vacate: ";
    cin >> roomNumber;
    if (cin.fail() || roomNumber < 1 || roomNumber > TOTAL_ROOMS) {
        cout << "\033[1;31mInvalid room number!\033[0m\n";
        return;
    }
    if (hotel[roomNumber - 1].available) {
        cout << "\033[1;31mRoom is already empty.\033[0m\n";
        return;
    }
    hotel[roomNumber - 1].available = true;
    hotel[roomNumber - 1].user = {"", "", ""};
    deleteFromDatabase(roomNumber);
    cout << "\033[1;32mRoom vacated successfully.\033[0m\n";
}
